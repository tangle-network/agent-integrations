new file mode 100644
index 0000000..3aeed3d
--- /dev/null
+++ b/src/hub-path.ts
@@ -0,0 +1,48 @@
+import { parseIntegrationToolName } from './catalog.js'
+import { TANGLE_INTEGRATIONS_CATALOG_PROVIDER_ID } from './tangle-catalog.js'
+
+/**
+ * Encode an integration tool name into the dot-path the platform hub routes on.
+ * Catalog tools (providerId === tangle-catalog) keep the catalog routing id as
+ * the first segment so the hub resolves them through the catalog runtime:
+ * `tangle-catalog.<connector>.<action>`. First-party adapters carry
+ * providerId === connectorId, so the path collapses to `<connector>.<action>`
+ * (the github precedent). The actionId may itself contain dots; it is always
+ * the trailing remainder, so `parseHubActionPath` round-trips it exactly.
+ */
+export function integrationToolNameToHubActionPath(toolName: string): string {
+  const { providerId, connectorId, actionId } = parseIntegrationToolName(toolName)
+  return providerId === TANGLE_INTEGRATIONS_CATALOG_PROVIDER_ID
+    ? `${providerId}.${connectorId}.${actionId}`
+    : `${connectorId}.${actionId}`
+}
+
+/**
+ * Decompose a hub action path back into its routing provider, connector, and
+ * action ids — the inverse of {@link integrationToolNameToHubActionPath} and
+ * the canonical parser the platform hub's binding check mirrors. For a
+ * `tangle-catalog.<connector>.<action>` path the connector is the second
+ * segment and the action id is the remainder (dots allowed). For a first-party
+ * path the first segment is both provider and connector. Returns null for an
+ * unparseable path so callers fail closed.
+ */
+export function parseHubActionPath(path: string): {
+  providerId: string
+  connectorId: string
+  actionId: string
+} | null {
+  const firstDot = path.indexOf('.')
+  if (firstDot <= 0) return null
+  const providerId = path.slice(0, firstDot)
+  const rest = path.slice(firstDot + 1)
+  if (!rest) return null
+  if (providerId === TANGLE_INTEGRATIONS_CATALOG_PROVIDER_ID) {
+    const secondDot = rest.indexOf('.')
+    if (secondDot <= 0) return null
+    const connectorId = rest.slice(0, secondDot)
+    const actionId = rest.slice(secondDot + 1)
+    if (!actionId) return null
+    return { providerId, connectorId, actionId }
+  }
+  return { providerId, connectorId: providerId, actionId: rest }
+}
